# ───────────────────────────────────────────────────────────────────
#  Mem0 self-host — Coolify env file
#  Copy to `.env` in Coolify's UI (or commit nothing — Coolify stores env vars itself)
# ───────────────────────────────────────────────────────────────────

# --- OpenAI ---
OPENAI_API_KEY=sk-REPLACE_ME

# --- Mem0 API auth (you'll send this as `Authorization: Bearer <value>`) ---
# Generate: openssl rand -base64 32
MEM0_API_KEY=REPLACE_WITH_RANDOM_SECRET

# --- Postgres ---
POSTGRES_DB=mem0
POSTGRES_USER=mem0
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
POSTGRES_COLLECTION_NAME=mem0_memories

# --- Neo4j ---
# Generate: openssl rand -base64 32
NEO4J_PASSWORD=REPLACE_WITH_RANDOM_SECRET

# --- Models (defaults are fine; override for higher quality) ---
MEM0_LLM_MODEL=gpt-4.1-mini
MEM0_EMBEDDER_MODEL=text-embedding-3-small
MEM0_EMBEDDING_DIMS=1536
