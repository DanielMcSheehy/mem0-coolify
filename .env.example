# ───────────────────────────────────────────────────────────────────
#  Hindsight self-host — Coolify env vars
#  Set each of these in Coolify's "Environment Variables" tab.
# ───────────────────────────────────────────────────────────────────

# --- OpenAI (for fact extraction + reflect reasoning) ---
OPENAI_API_KEY=sk-REPLACE_ME

# --- Hindsight Bearer token (required by all clients) ---
# Generate: openssl rand -hex 32      # hex is URL-safe; avoid +/= base64 chars
HINDSIGHT_API_KEY=REPLACE_WITH_RANDOM_SECRET

# --- Optional model overrides ---
HINDSIGHT_LLM_MODEL=gpt-5-mini
HINDSIGHT_EMBEDDINGS_PROVIDER=local
HINDSIGHT_LOG_LEVEL=info
