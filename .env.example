# ───────────────────────────────────────────────────────────────────
#  Mem0 self-host — Coolify env vars
#  Set each of these in Coolify's "Environment Variables" tab.
# ───────────────────────────────────────────────────────────────────

# --- OpenAI ---
OPENAI_API_KEY=sk-REPLACE_ME

# --- Mem0 API auth ---
# Sent by clients as `Authorization: Bearer <ADMIN_API_KEY>`
# Generate: openssl rand -base64 32
ADMIN_API_KEY=REPLACE_WITH_RANDOM_SECRET

# Required by the server to sign internal JWTs, even when ADMIN_API_KEY is used.
# Generate: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# --- Postgres ---
# Note: leave POSTGRES_DB and POSTGRES_USER as 'postgres'. The Mem0 server uses
# a second database called 'mem0_app' which is created automatically by init-db.sh
# on first Postgres boot. Changing these defaults can break that flow.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
POSTGRES_COLLECTION_NAME=mem0_memories

# --- Models (defaults are fine; override for higher quality) ---
MEM0_LLM_MODEL=gpt-4.1-mini
MEM0_EMBEDDER_MODEL=text-embedding-3-small
